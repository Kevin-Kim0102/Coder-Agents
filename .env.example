# Optional. Explicit environment variables always win over the settings file.
# CODER_AGENTS_SETTINGS=/path/to/settings.json   # default: ${XDG_CONFIG_HOME:-~/.config}/coder-agents/settings.json
# CODER_AGENTS_CONFIG=/path/to/config.json       # default: ~/.local/state/kiro-panel/config.json (legacy-compatible)
# HTTPS_PROXY=http://proxy.example:8080
